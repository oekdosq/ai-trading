[Unit]
Description=AI Trading XAUUSD web app (FastAPI + uvicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai-trading
# Baca .env (sudah berisi WEB_SECRET, OANDA, dll)
EnvironmentFile=/home/ubuntu/ai-trading/.env
ExecStart=/home/ubuntu/ai-trading/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
