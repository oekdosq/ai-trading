# OANDA Practice (demo) credentials
# Dapatkan dari https://www.oanda.com/demo-account/
OANDA_TOKEN=your_oanda_practice_access_token
OANDA_ACCOUNT_ID=your_oanda_account_id

# LLM lokal (Ollama) — default model
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# Web app (FastAPI) — sesi login
# Ganti WEB_SECRET dengan string acak panjang (untuk produksi).
# Biarkan kosong → otomatis generate acak (sesi di-reset tiap restart).
# WEB_SECRET=
# WEB_TOKEN_MINUTES=4320
